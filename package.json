{
  "name": "ts-agent-harness",
  "version": "1.0.0",
  "private": true,
  "description": "A persistent coding agent runtime with policy, planning, budgets, tasks and rollback",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "agent": "npm run build --silent && node --env-file-if-exists=.env dist/src/cli.js",
    "demo": "npm run agent -- demo"
  },
  "dependencies": {
    "ajv": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
