{
  "name": "ts-agent-harness",
  "version": "1.0.0",
  "private": true,
  "description": "A persistent coding agent runtime with policy, planning, budgets, tasks and rollback",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "agent": "./agent",
    "demo": "npm run agent -- demo",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "ajv": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
